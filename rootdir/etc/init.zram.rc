on early-init
    write /sys/block/zram0/comp_algorithm lz4

on post-fs-data
    # zram reset is necessary for before the enabling zram
    write /sys/block/zram0/reset 1

    # zram compression algorithm
    write /sys/block/zram0/comp_algorithm lz4

    # set 2gb zram size
    write /sys/block/zram0/disksize 2147483648

    # enable zram
    exec -- /system/bin/mkswap /dev/block/zram0
    exec -- /system/bin/swapon /dev/block/zram0 -p 32758

    # vm configurations
    write /proc/sys/vm/swappiness 60
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/vfs_cache_pressure 50
    write /proc/sys/vm/watermark_scale_factor 125
    write /proc/sys/vm/extfrag_threshold 750

    write /sys/block/mmcblk0/queue/read_ahead_kb 128